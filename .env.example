# URL pública canónica para generación de Sitemap, Robots, OpenGraph y JSON-LD
NEXT_PUBLIC_SITE_URL="https://paulmeza.vercel.app"

# Cadena de conexión Serverless a Neon PostgreSQL (Usar rol con privilegios mínimos: INSERT/SELECT)
# Ejemplo: postgresql://app_writer:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# Cloudflare Turnstile (Anti-Bot Verification)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# NOTA DE SEGURIDAD (OPSEC):
# No almacenes tokens administrativos de despliegue (como VERCEL_TOKEN) en .env.local.
# Utiliza `npx vercel login` para autenticación local segura fuera del repositorio.

